# Allowlist: personal queues, workflows, media, diagnostics and credentials stay local.
/*
!/.gitignore
!/.gitattributes
!/app.py
!/verify.py
!/requirements.txt
!/requirements-build.txt
!/README.md
!/README.txt
!/LICENSE
!/CHANGELOG.md
!/Launch_WAN_Batch_Studio.bat
!/packaging/
!/scripts/
!/docs/
!/.github/
/packaging/*
!/packaging/installer.iss
/scripts/*
!/scripts/build.ps1
/docs/*
!/docs/index.html
!/docs/style.css
!/docs/.nojekyll
!/.github/workflows/
!/.github/workflows/build.yml
!/scripts/collect_licenses.py
